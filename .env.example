# Football-Data.org API credentials
# Sign up for a free key at https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your_api_key_here

# Base URL (default is correct for Football-Data.org v4)
FOOTBALL_DATA_API_URL=https://api.football-data.org/v4

# Comma-separated competition codes to include in the /clubs endpoint.
# Free-tier codes: PL (Premier League), PD (La Liga), BL1 (Bundesliga),
#                  SA (Serie A), FL1 (Ligue 1)
FOOTBALL_DATA_COMPETITIONS=PL,PD,BL1,SA,FL1
