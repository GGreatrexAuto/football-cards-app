# Test Environment Configuration
# This file contains environment variables specific to E2E testing

# Backend API Configuration
REACT_APP_API_BASE_URL=http://localhost:8000/api/v1

# Test Configuration
TEST_ENV=e2e
NODE_ENV=test

# Playwright Configuration
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_API_URL=http://localhost:8000

# Test Data Configuration
TEST_DATA_PERSISTENCE=false
TEST_CLEANUP_ENABLED=true

# Screenshot and Video Configuration
PLAYWRIGHT_SCREENSHOT_DIR=test-results/screenshots
PLAYWRIGHT_VIDEO_DIR=test-results/videos

# CI Configuration
CI=false
PLAYWRIGHT_RETRIES=0
PLAYWRIGHT_WORKERS=2

# Mock Configuration
USE_API_MOCKS=false
MOCK_API_LATENCY=0

# Browser Configuration
BROWSER_HEADLESS=true
BROWSER_SLOW_MO=0